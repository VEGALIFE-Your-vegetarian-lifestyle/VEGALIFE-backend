#!/bin/sh
# Validate Conventional Commits format: <type>(<scope>): <summary>
# Types: feat fix refactor test chore docs style perf ci
# Summary: lowercase, no trailing period, under 72 chars (subject line)
# A body is recommended; this hook enforces the subject line format.

commit_msg_file="$1"
subject=$(head -n 1 "$commit_msg_file")

# Allow merge and revert commits generated by git itself
case "$subject" in
  Merge\ *|Revert\ *|fixup!*|squash!*)
    exit 0
    ;;
esac

# Conventional commit pattern
pattern='^(feat|fix|refactor|test|chore|docs|style|perf|ci)(\([a-z0-9\-]+\))?: [a-z].*[^.]$'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "ERROR: commit subject does not follow Conventional Commits:" >&2
  echo "  $subject" >&2
  echo "" >&2
  echo "Expected: <type>(<scope>): <summary>" >&2
  echo "  type   = feat|fix|refactor|test|chore|docs|style|perf|ci" >&2
  echo "  scope  = optional lowercase kebab-case, e.g. auth, db" >&2
  echo "  summary= lowercase, no trailing period, under 72 chars" >&2
  echo "" >&2
  echo "See AGENTS.md > Project conventions > Commit messages." >&2
  exit 1
fi

# Subject length check (72 chars max for the subject line)
subject_len=${#subject}
if [ "$subject_len" -gt 72 ]; then
  echo "ERROR: commit subject is $subject_len chars (max 72):" >&2
  echo "  $subject" >&2
  exit 1
fi

exit 0
