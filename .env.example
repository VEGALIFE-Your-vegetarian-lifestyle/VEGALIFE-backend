# Vegalife local environment template.
#
# HOW THIS FILE IS READ
#   * The dev profile (application-dev.yml) imports this syntax file as
#     `optional:file:./.env[.properties]`. Copy this file to `.env` at the repo
#     root -- `.env` is gitignored and `.dockerignore`d, so it never reaches an
#     image or a deploy.
#   * Precedence: real OS environment variables > `.env` > the `${...:default}`
#     values in application.yml. A deploy (Render) is therefore always
#     authoritative over this file.
#   * KEY=value lines are parsed by the JDK properties parser, not a dotenv
#     parser. Keep plain `KEY=value`: no `export` prefix, no quotes around
#     values, no ${OTHER} interpolation, no backslashes, no `:` separator.
#   * These keys are read on every profile because application.yml declares the
#     placeholders (ApplicationYamlPlaceholderParityTest enforces that). A
#     profile-specific file may only override a default.
#   * SPRING_PROFILES_ACTIVE is the one key this file cannot set: profiles are
#     resolved before config data is read. Set it in the shell or the IDE run
#     configuration; the dev profile is active by default.
#   * DB_URL must point at a host the JVM can reach. `postgres` is a Docker
#     Compose service name and only resolves inside the compose network; use
#     `localhost` when the database is a local container or an installed server.

# Database
DB_USER=vegalife
DB_PASSWORD=vegalife
DB_URL=jdbc:postgresql://localhost:5432/vegalife

# Spring
# Dev activates the profile through application.yml's spring.profiles.default.
# SPRING_PROFILES_ACTIVE=dev
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_FLYWAY_ENABLED=true

# Server
SERVER_PORT=8080
# PORT is injected by Render and its container; leave it unset locally.
# PORT=8080

# Mail
# Same MAIL_* keys for every profile:
#   - dev profile (application-dev.yml): defaults to localhost:1025
#     (MailHog/mailpit), with SMTP auth and STARTTLS off.
#   - prod profile (application-prod.yml): defaults to Brevo SMTP relay
#     smtp-relay.brevo.com:2525 (Render free blocks outbound 25/465/587);
#     MAIL_USERNAME, MAIL_PASSWORD and MAIL_FROM are required there with
#     no defaults.
# MAIL_FROM must be an address your SMTP relay accepts (e.g. your single
# verified Brevo sender) -- never a placeholder domain. Leave it empty for a
# local catcher: JavaMail then omits the From header instead of failing.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Set both to true when pointing MAIL_HOST at a real relay instead of a catcher.
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# Auth (prod requires AUTH_JWT_SECRET, min 32 chars; see application-prod.yml).
# Dev and prod both default the issuer/audience and token lifetimes in YAML.
AUTH_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Google sign-in (ADR-017). Optional: a blank pair makes the endpoint fail
# closed while password login keeps working. All three come from the Google
# Cloud console, and GOOGLE_REDIRECT_URI must be registered for the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Cloudinary (direct-to-storage uploads; see docs/feats/upload-media-api.md).
# All three are required for POST /api/media/upload to mint a grant.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Embeddings -- the post content filter (app.filter.embedding; see ADR-014).
# Active provider is Gemini; EMBED_API_KEY is a secret: set it in your local .env
# (or your deploy environment), never commit a real value. Without it the filter
# can still start but embedding calls fail at request time.
# EMBED_PROVIDER=gemini
# EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# EMBED_MODEL=gemini-embedding-001
# EMBED_API_KEY=
# EMBED_DIMENSIONS=768

# Filter tuning (ADR-015, issue #156). Thresholds are calibrated against
# gemini-embedding-001 at 768 dims -- see docs/feats/filter-calibration-gemini.md
# and docs/feats/duplicate-post-detection.md before changing them.
# FILTER_ENABLED=true
# DUPLICATE_DETECTION_ENABLED=true
# DUPLICATE_THRESHOLD=0.85

# HuggingFace embeddings are DORMANT (ADR-014): the retained client is only
# re-armed by EMBED_PROVIDER=hf. Do not set these expecting the filter to use
# them. HF_TOKEN is a secret; never commit a real value.
# HF_TOKEN=
# HF_EMBEDDING_BASE_URL=https://router.huggingface.co/hf-inference/models
# HF_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct

# AI chat provider (POST /api/ai/messages, /api/ai/messages/stream) -- any
# OpenAI-compatible endpoint. Defaults assume OpenAI
# (application.yml); set these to point chat at another provider. AI_CHAT_BASE_URL
# is the host root only (no trailing /v1) -- Spring AI appends /v1/chat/completions
# itself. Chat and embedding credentials are separate; there is no HF_TOKEN
# fallback (ADR-014). Dev/test fall back to a dummy key, so real chat calls only
# fail at request time. AI_CHAT_API_KEY is a secret: set it in your local .env
# (or Render), never commit a real value.
# AI_CHAT_BASE_URL=https://api.openai.com
# AI_CHAT_API_KEY=
# AI_CHAT_MODEL=gpt-4o-mini

# Payments / VNPay (dev profile; see docs/adrs/008-vnpay-integration.md).
# Both credentials are required for POST /api/payments/checkout: dev enables
# VNPay by default, so with blank values checkout answers HTTP 500 (FR-019)
# rather than signing with an empty secret. Get them from the VNPay sandbox
# merchant portal. The IPN webhook works regardless (it verifies with the
# same secret, so it fails closed without it).
# The secret is a secret: set it in your local .env (or Render), never commit
# a real value. Exporting these also unskips VnpaySandboxIntegrationTest
# (src/test/java/com/vegalife/integration/payment/) on `mvnw verify`.
VNPAY_TMN_CODE=
VNPAY_SECURE_HASH_SECRET=
# Dev defaults to the VNPay sandbox payment endpoint shown here; prod must set
# its own (no endpoint default ships for prod). VNPAY_ENABLED defaults to false
# in application.yml and is turned on by application-dev.yml.
# VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_ENABLED=true
# VNPAY_LOCALE=vn
# Frontend page the gateway redirects the browser to after payment (never an
# API path); default http://localhost:3000/payment/result.
# PAYMENT_RETURN_URL=http://localhost:3000/payment/result

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_VEGALIFE=DEBUG

# Health: /actuator/health (status only) -- see docs/arch/deployment.md
