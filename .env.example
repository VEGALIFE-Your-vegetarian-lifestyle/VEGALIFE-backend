# Database
DB_USER=vegalife
DB_PASSWORD=vegalife
DB_URL=jdbc:postgresql://postgres:5432/vegalife

# Spring
SPRING_PROFILES_ACTIVE=dev
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_FLYWAY_ENABLED=true

# Server
SERVER_PORT=8080

# Mail
# Same MAIL_* keys for every profile:
#   - dev profile (application-dev.yml): defaults to localhost:1025
#     (MailHog/mailpit).
#   - prod profile (application-prod.yml): defaults to Brevo SMTP relay
#     smtp-relay.brevo.com:2525 (Render free blocks outbound 25/465/587);
#     MAIL_USERNAME, MAIL_PASSWORD and MAIL_FROM are required there with
#     no defaults.
# MAIL_FROM must be an address your SMTP relay accepts (e.g. your single
# verified Brevo sender) — never a placeholder domain.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=your-verified-sender@example.com

# Auth (prod requires AUTH_JWT_SECRET, min 32 chars; see application-prod.yml)
AUTH_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_VEGALIFE=DEBUG

# Health: /actuator/health (status only) — see docs/arch/deployment.md
