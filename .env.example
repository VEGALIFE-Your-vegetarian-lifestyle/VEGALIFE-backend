# Database
DB_USER=vegalife
DB_PASSWORD=vegalife
DB_URL=jdbc:postgresql://postgres:5432/vegalife

# Spring
SPRING_PROFILES_ACTIVE=dev
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_FLYWAY_ENABLED=true

# Server
SERVER_PORT=8080

# Mail
# Same MAIL_* keys for every profile:
#   - dev profile (application-dev.yml): defaults to localhost:1025
#     (MailHog/mailpit).
#   - prod profile (application-prod.yml): defaults to Brevo SMTP relay
#     smtp-relay.brevo.com:2525 (Render free blocks outbound 25/465/587);
#     MAIL_USERNAME, MAIL_PASSWORD and MAIL_FROM are required there with
#     no defaults.
# MAIL_FROM must be an address your SMTP relay accepts (e.g. your single
# verified Brevo sender) — never a placeholder domain.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=your-verified-sender@example.com

# Auth (prod requires AUTH_JWT_SECRET, min 32 chars; see application-prod.yml)
AUTH_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Cloudinary (direct-to-storage uploads; see docs/feats/upload-media-api.md).
# All three are required for POST /api/media/upload to mint a grant.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI / HuggingFace — all optional; application.yml has the defaults below.
# HF_TOKEN is a secret: set it in your local .env (or Render), never commit
# a real value. Dev/test fall back to dummy keys without it, so real embedding
# calls only fail at request time.
# HF_TOKEN=
# HF_BASE_URL=https://router.huggingface.co/v1                      # OpenAI-compat chat base (spring.ai.openai)
# HF_EMBEDDING_BASE_URL=https://router.huggingface.co/hf-inference/models  # filter embedding route (app.filter.embedding)
# HF_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct

# Payments / VNPay (dev profile; see docs/adrs/008-vnpay-integration.md).
# Both credentials are required for POST /api/payments/checkout: dev enables
# VNPay by default, so with blank values checkout answers HTTP 500 (FR-019)
# rather than signing with an empty secret. Get them from the VNPay sandbox
# merchant portal. The IPN webhook works regardless (it verifies with the
# same secret, so it fails closed without it).
# The secret is a secret: set it in your local .env (or Render), never commit
# a real value. Exporting these also unskips VnpaySandboxIntegrationTest
# (src/test/java/com/vegalife/integration/payment/) on `mvnw verify`.
VNPAY_TMN_CODE=
VNPAY_SECURE_HASH_SECRET=
# Optional — dev defaults to the VNPay sandbox payment endpoint shown here; prod
# must set its own (no endpoint default ships outside application-dev.yml).
# VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Frontend page the gateway redirects the browser to after payment (never an
# API path); default http://localhost:3000/payment/result.
# PAYMENT_RETURN_URL=http://localhost:3000/payment/result

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_VEGALIFE=DEBUG

# Health: /actuator/health (status only) — see docs/arch/deployment.md
