# Database
DB_USER=vegalife
DB_PASSWORD=vegalife
DB_URL=jdbc:postgresql://postgres:5432/vegalife

# Spring
SPRING_PROFILES_ACTIVE=dev
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_FLYWAY_ENABLED=true

# Server
SERVER_PORT=8080

# Mail
# Dev profile (DEV_MAIL_*): defaults to localhost:1025 (MailHog/mailpit).
# Prod profile (MAIL_*): Brevo SMTP relay, host/port defaulted in
# application-prod.yml to smtp-relay.brevo.com:2525 (Render free blocks
# outbound 25/465/587); MAIL_USERNAME, MAIL_PASSWORD and MAIL_FROM are
# required with no defaults.
DEV_MAIL_HOST=localhost
DEV_MAIL_PORT=1025
DEV_MAIL_USERNAME=
DEV_MAIL_PASSWORD=
MAIL_FROM=noreply@vegalife.local

# Auth (prod requires AUTH_JWT_SECRET, min 32 chars; see application-prod.yml)
AUTH_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_VEGALIFE=DEBUG

# Health: /actuator/health (status only) — see docs/arch/deployment.md
