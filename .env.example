# Database
DB_USER=vegalife
DB_PASSWORD=vegalife
DB_URL=jdbc:postgresql://postgres:5432/vegalife

# Spring
SPRING_PROFILES_ACTIVE=dev
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_FLYWAY_ENABLED=true

# Server
SERVER_PORT=8080

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_VEGALIFE=DEBUG

# Actuator: not yet a dependency (Planned, see docs/arch/dependencies.md;
# queue metrics are log-based per ADR-005)